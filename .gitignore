__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.uv-cache/
.venv/
.env
.env.*
!.env.example
.data/
.coverage
coverage.xml
htmlcov/
node_modules/
.next/
dist/
build/
*.egg-info/
.superpowers/
.agents/
*.log

# Source documents used for benchmarking stay out of the repository. They are
# third-party engineering reports, large, and not ours to redistribute; the
# repository is public. Modal mounts them from local disk at run time.
*.pdf
*.docx
!tests/**/*.pdf
!tests/**/*.docx

# Raw benchmark output. Regenerable by re-running the script that made it, and it
# quotes text recovered from those same third-party reports. The findings that
# matter are distilled into PLAN.md, which is what review should read.
docling_bench_result.json
docling_ocr_probe_result.json
ocr_comparison_result.json

# Per-machine tool permissions, not a project setting.
.claude/settings.local.json

# Agent skills are installed per machine as symlinks into .agents/, which is
# ignored; skills-lock.json is the tracked record of what to install.
.claude/skills/
